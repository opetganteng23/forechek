{
  "name": "publication-prepare",
  "private": true,
  "version": "1.0.0",
  "description": "Forechek - asisten persiapan naskah ilmiah (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web && eslint packages scripts --ext .js",
    "test": "npm test --workspaces --if-present",
    "seed:journals": "node scripts/seedJournals.js",
    "seed:venues": "node scripts/seedVenues.js",
    "retention": "node scripts/retention.js",
    "preflight": "node scripts/preflight.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
