# ==============================================================================================================================
# Forechek - contoh environment. Salin ke apps/web/.env.local (lokal) atau shared/.env.local (server; chmod 600).
# JANGAN commit berkas .env* selain berkas ini. Semua nilai di bawah adalah PLACEHOLDER (bukan rahasia nyata).
# Penjelasan lengkap tiap variabel, cara membuat nilai, dan akibat bila kosong: docs/ENV_CHECKLIST.md
# Periksa konfigurasi sebelum start:  npm run preflight
# ==============================================================================================================================

# ==============================================================================================================================
# A. WAJIB (produksi menolak start bila salah satu kosong/tidak valid; pesan menyebut NAMA variabel)
# ==============================================================================================================================
NODE_ENV=production
# URL publik aplikasi (https). Dipakai untuk tautan di email dan NextAuth.
BASE_URL=https://forechek.ailo.ai.id
NEXTAUTH_URL=https://forechek.ailo.ai.id
# Penandatangan sesi (JWT). Min. 32 karakter acak:  openssl rand -base64 32
NEXTAUTH_SECRET=GANTI-DENGAN-HASIL-openssl-rand-base64-32
# Koneksi MongoDB (Atlas atau lokal), mis. mongodb+srv://USER:PASSWORD@HOST/forechek?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/forechek
# Di belakang nginx/hosting yang MENAMBAHKAN alamat klien ke X-Forwarded-For: true. Langsung ke internet tanpa proxy: false.
# Wajib eksplisit di produksi (tanpa ini semua klien berbagi satu bucket batas laju).
TRUST_PROXY=true

# ==============================================================================================================================
# B. WAJIB UNTUK FITUR TERTENTU (kosong = fitur itu mati dengan pesan jelas; aplikasi tetap berjalan)
# ==============================================================================================================================
# --- AI (chat, laporan kesiapan, usulan edit) ---
ANTHROPIC_API_KEY=sk-ant-GANTI
# ID model dibaca dari env (tidak di-hardcode). Nilai di bawah adalah DEFAULT yang disarankan; pastikan ID masih berlaku di console.anthropic.com.
# Pemakaian ke API nyata TIDAK DIVERIFIKASI di repo ini.
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_REPORT=claude-sonnet-5-5
AI_MODEL_LIGHT=claude-haiku-5-5
# --- Literatur (pencarian/verifikasi referensi). Tanpa ini fitur referensi menolak (PROVIDER_NOT_CONFIGURED) ---
LITERATURE_PROVIDERS=openalex,crossref
# Email kontak untuk "polite pool" OpenAlex/Crossref (sangat disarankan)
LITERATURE_CONTACT_EMAIL=kontak@forechek.ailo.ai.id
# --- Email (verifikasi akun, reset password): SMTP biasa (host/port/user/password). Wajib bila REQUIRE_EMAIL_VERIFICATION=true ---
# Contoh: hosting email Anda, Brevo, Mailgun, atau Gmail dengan App Password (smtp.gmail.com, 587). Port 587 = STARTTLS, 465 = TLS langsung.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=noreply@example.org
SMTP_PASS=GANTI
# Pengirim yang tampil; kosong = "Forechek" <SMTP_USER>
SMTP_FROM=Forechek <noreply@example.org>
# --- Login Google (OPSIONAL; kosong = tombol "Lanjutkan dengan Google" disembunyikan, login email/password tetap berfungsi) ---
GOOGLE_CLIENT_ID=GANTI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-GANTI

# ==============================================================================================================================
# C. OPSIONAL
# ==============================================================================================================================
# true = login email/password ditolak sampai email terverifikasi (aktifkan SETELAH email terbukti berfungsi)
REQUIRE_EMAIL_VERIFICATION=false
# Origin tambahan yang boleh mengirim POST/PATCH/DELETE dari browser (dipisah koma). Kosong = hanya host sendiri.
ALLOWED_ORIGINS=https://forechek.ailo.ai.id
# Jumlah proxy tepercaya di depan aplikasi (default 1 = nginx)
TRUST_PROXY_HOPS=1
# Redis untuk batas laju lintas instance (wajib bila pm2 mode cluster). Kosong = memory per proses.
REDIS_URL=
# Batas agen AI per giliran (nilai awal PROVISIONAL; kosong = default kode)
AI_MAX_ITERATIONS=
AI_MAX_TOOL_CALLS=
AI_TURN_TIMEOUT_MS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_TOTAL_TOKENS_PER_TURN=
AI_CONTEXT_BUDGET_TOKENS=
# true = prompt caching Anthropic (default mati sampai kompatibilitas dan biaya diverifikasi)
AI_PROMPT_CACHE=
# Literatur: kunci Semantic Scholar (tanpa kunci batas laju sangat ketat), timeout ms (default 8000), TTL cache detik (default 600)
SEMANTIC_SCHOLAR_API_KEY=
LITERATURE_TIMEOUT_MS=
LITERATURE_CACHE_TTL_SEC=
# Trial: jumlah paper (proyek) yang boleh dibuat akun TANPA langganan aktif, seumur akun (default 1). Menghapus paper tidak mengembalikan jatah.
TRIAL_PAPER_LIMIT=1
# Kuota per paket (SEMENTARA; tetapkan final setelah biaya terukur)
QUOTA_FREE_TOKENS=100000
QUOTA_FREE_MESSAGES=30
QUOTA_PRO_TOKENS=2000000
QUOTA_PRO_MESSAGES=1000
QUOTA_INST_TOKENS=10000000
QUOTA_INST_MESSAGES=5000
# Pembayaran Midtrans (SANDBOX dulu). Webhook menolak 503 bila MIDTRANS_SERVER_KEY kosong.
MIDTRANS_SERVER_KEY=SB-Mid-server-GANTI
MIDTRANS_CLIENT_KEY=SB-Mid-client-GANTI
MIDTRANS_IS_PRODUCTION=false
# Retensi (npm run retention): hapus proyek berumur retentionDays setelah masa tenggang. Default dry-run.
RETENTION_ENABLED=
RETENTION_GRACE_DAYS=7
# Rute lama (unggah naskah Cloudinary, analisis lama): default MATI. true hanya bila sadar risikonya.
LEGACY_ROUTES_ENABLED=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================================================================
# D. UJI / PENGEMBANGAN SAJA (JANGAN diisi di produksi nyata)
# ==============================================================================================================================
# Provider AI PALSU (bukan Claude). Di produksi ditolak kecuali AI_ALLOW_FAKE=true.
AI_PROVIDER=
AI_ALLOW_FAKE=
# Korpus literatur SINTETIS untuk uji (bukan sumber nyata). Di produksi ditolak kecuali LITERATURE_ALLOW_FIXTURE=true.
LITERATURE_ALLOW_FIXTURE=
