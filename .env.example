# Salin ke apps/web/.env.local (Next.js membaca env dari situ). JANGAN commit file .env.local.
# Untuk skrip di scripts/ (dijalankan dari root), buat juga .env di root berisi MONGODB_URI.

# === APP ===
BASE_URL=http://localhost:3000
NODE_ENV=development

# === MONGODB ===
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/publikasi_db?retryWrites=true&w=majority

# === NEXTAUTH ===
# Buat secret acak, mis.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# === AUTH POLICY ===
# true = login email/password ditolak sampai email diverifikasi. Aktifkan di staging/production
# setelah mailer (Gmail OAuth2) terbukti berfungsi.
REQUIRE_EMAIL_VERIFICATION=false

# === GOOGLE OAUTH (untuk Login) ===
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# === GMAIL MAILER (OAuth2) ===
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxx
GMAIL_ACCESS_TOKEN=ya29.xxxxxxxxxxxxxxxxxx

# === ANTHROPIC (Claude AI) ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# Nama model dibaca dari config, bukan hardcode (MTS P7). Dipakai mulai Tahap 3.
AI_MODEL_CHAT=
AI_MODEL_REPORT=
AI_MODEL_LIGHT=

# === KUOTA (SEMENTARA - tetapkan final setelah biaya per sesi terukur, MTS Bagian 13) ===
QUOTA_FREE_TOKENS=100000
QUOTA_FREE_MESSAGES=30
QUOTA_PRO_TOKENS=2000000
QUOTA_PRO_MESSAGES=1000
QUOTA_INST_TOKENS=10000000
QUOTA_INST_MESSAGES=5000

# === FILE UPLOAD (legacy; alur PDF/DOCX lama) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx

# === PAYMENT ===
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
